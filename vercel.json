{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd gui && CHROMEDRIVER_SKIP_DOWNLOAD=true npm ci",
  "buildCommand": "cd gui && NODE_ENV=production ENABLE_SERVICE_WORKER=1 npm run build",
  "outputDirectory": "gui/build",
  "rewrites": [
    { "source": "/", "destination": "/editor.html" }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
