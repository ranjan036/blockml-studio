{
  "name": "blockml-studio-extensions",
  "private": true,
  "version": "0.1.0",
  "description": "AI extensions for BlockML Studio (Face, Hand & Pose). Models run in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch-models": "node scripts/fetch-models.mjs",
    "build": "vite build && node scripts/assemble.mjs && node starters/build-starters.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow-models/face-landmarks-detection": "1.0.6",
    "@tensorflow-models/hand-pose-detection": "2.0.1",
    "@tensorflow-models/mobilenet": "2.1.1",
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
